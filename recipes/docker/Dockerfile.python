# Python 서버용 틀. 과제 루트에 Dockerfile로 복사해 진입 파일·포트·데이터 경로를 과제 README대로 고친다.
# 서버는 PORT·DATA_DIR 환경변수를 읽고 0.0.0.0에 바인딩하며 GET /health → 200 을 준다.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=3000 DATA_DIR=/data
WORKDIR /app

# requirements.txt가 있을 때만 주석을 푼다(표준 라이브러리만 쓰면 그대로 둔다).
# COPY requirements.txt .
# RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN useradd --create-home --uid 10001 app && mkdir -p /data && chown app:app /data
USER app
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT','3000'), timeout=2)" || exit 1
CMD ["python", "server.py"]
